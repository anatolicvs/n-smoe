{
    # training settings
    "im_chn": 3,    # Image channel
    "sigma_chn": 1, # Number of channel for the estimated noise varaince map
    "hr_size": 96, 
    "batch_size": 2, 
    "epochs": 120,
    
    "lr_E": 1e-4, 
    "lr_D": 5e-4, 
    "lr_S": 5e-4, 
    "lr_K": 5e-4,
    
    "lr_min": 5e-5, 
    "print_freq": 100,
    "num_workers": 8, 
    "prefetch_factor": 2, 
    "db_length": 10000,
    "save_dir": "",
    "resume": "", 


    # network N-SMoE
    "kernel_chn": 3,
    "noise_avg": "True",
    "model_channels": 32,
    "num_res_blocks": 2, 
    "attention_resolutions": [16, 8, 4],
    "dropout": 0.1,
    "channel_mult": [2, 4, 8],
    "conv_resample":"False",
    "dims": 2,
    "use_checkpoint": "True",
    "use_fp16": "False",
    "num_heads": 4,
    "num_head_channels": -1,
    "resblock_updown": "True",
    "num_groups": 32,
    "resample_2d": "False",
    
    "resizer_num_layers": 3,
    "resizer_avg_pool": "False",
    
    "activation": "LeakyReLU",
    "rope_theta": 10000.0,
    "attention_type": "attention",

    # CRITICAL FIXES FOR OVER-SMOOTHING
    "kernel": 16,                    # REDUCED from 32 (fewer kernels = less over-smoothing)
    "kernel_type": "gaussian",
    "phw": 16,
    "overlap": 12,                   # INCREASED from 8 (75% overlap for smooth blending)
    "sharpening_factor": 4.0,        # INCREASED from 1.0 (critical for sharp edges)
    "use_sh_color": true,            # ENABLED for view-dependent color (prevents bleeding)
    "sh_degree": 3,

    # network architecture
    "dep_S": 5,
    "dep_K": 8,
    "n_feat": [96, 160, 224], 
    "n_resblocks": 2, 
    "extra_mode": "Both",
    "noise_cond": "True",
    "kernel_cond": "True",

    # training and validation data path
    "train_hr_patchs": "/home/ozkan/works/n-smoe/tpami/VIRNet/test_data/CBSD68",
    "val_hr_path": "/home/ozkan/works/n-smoe/tpami/VIRNet/test_data/Set14", 
    "add_jpeg": "False",
    "kernel_shift": "False",
    "downsampler": "Bicubic",
    "chn":"rgb",  

    # degradation process
    "sf": 2,
    "k_size": 21,
    "noise_level": [0.01, 15],
    "noise_jpeg": [0.01, 10],

    # hyper-parameters of our model
    "eps2": 1e-5,
    "r2": 1e-4,
    "var_window": 9,
    "kappa0": 50,
    "penalty_K": [0.02, 2],
    "clip_grad_R": 5e2,
    "clip_grad_M": 1e2,
    "clip_grad_S": 1e2, 
    "clip_grad_K": 5e2
}
